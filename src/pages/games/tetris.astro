---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="俄罗斯方块" description="原创实现的像素风俄罗斯方块小游戏。" game>
  <section class="narrow game-layout">
    <header class="page-header">
      <p class="eyebrow">GAME / 05</p>
      <h1>俄罗斯方块</h1>
      <p>移动、旋转和快速下落，完成消行挑战。</p>
    </header>
    <div class="game-panel" id="tetris-game">
      <div class="game-hud">
        <span>分数 <strong data-score>0</strong></span>
        <span>等级 <strong data-level>1</strong></span>
        <span>行数 <strong data-lines>0</strong></span>
        <span>最高 <strong data-high>0</strong></span>
        <span data-state>准备</span>
      </div>
      <div class="game-stage">
        <div class="tetris-layout">
          <canvas width="300" height="600" aria-label="俄罗斯方块游戏画面"></canvas>
          <div class="next-piece">
            <span>下一个</span>
            <canvas width="120" height="120" data-next aria-label="下一个方块预览"></canvas>
          </div>
        </div>
        <div class="touch-controls" aria-label="触控操作">
          <button class="up" data-action="rotate" aria-label="旋转">↻</button>
          <button class="left" data-move="left" aria-label="向左">◀</button>
          <button class="down" data-action="drop" aria-label="直落">▼</button>
          <button class="right" data-move="right" aria-label="向右">▶</button>
        </div>
        <div class="game-controls">
          <button class="button small" data-action="start">开始</button>
          <button class="button small secondary" data-action="pause">暂停</button>
          <button class="button small secondary" data-action="restart">重新开始</button>
        </div>
        <p class="game-help">键盘：方向键、空格直落 · 移动端：使用触控按钮</p>
      </div>
    </div>
  </section>
</BaseLayout>
<script>
  import { startTetrisGame } from '../../games/tetris';
  const root = document.querySelector('#tetris-game');
  if (root instanceof HTMLElement) startTetrisGame(root);
</script>
