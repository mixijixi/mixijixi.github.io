---
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL.slice(0, -1) : import.meta.env.BASE_URL;
const href = (path: string) => `${base}${path}`;
const pathname = Astro.url.pathname;
// 剥离 base 得到相对路径并补齐尾斜杠，避免“首页永远高亮”的误判
const relative = (base && pathname.startsWith(base) ? pathname.slice(base.length) : pathname) || '/';
const current = relative !== '/' && !relative.endsWith('/') ? `${relative}/` : relative;
const navItems = [
  { label: '首页', href: '/' },
  { label: '博客', href: '/blog/' },
  { label: '小游戏', href: '/games/' }
];
---
<header class="site-header">
  <div class="header-inner">
    <a class="brand" href={href('/')}>
      <span class="brand-mark" aria-hidden="true">◆</span>
      <span>PIXEL / 明心</span>
    </a>
    <nav class="site-nav" aria-label="主导航">
      {navItems.map((item) => {
        // 首页只在根路径精确高亮；其余项按前缀匹配
        const isActive = item.href === '/' ? current === '/' : current === item.href || current.startsWith(item.href);
        return <a href={href(item.href)} aria-current={isActive ? 'page' : undefined}>{item.label}</a>;
      })}
    </nav>
  </div>
</header>
