---
type Props = {
  title: string;
  description: string;
  href: string;
  tags: string[];
  icon: string;
};

const { title, description, href, tags, icon } = Astro.props;
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL.slice(0, -1) : import.meta.env.BASE_URL;
---
<article class="card">
  <span class="icon-box" aria-hidden="true">{icon}</span>
  <h3>{title}</h3>
  <p>{description}</p>
  <div class="tag-list">
    {tags.map((tag) => <span class="tag">{tag}</span>)}
  </div>
  <a class="card-link" href={`${base}${href}`}>开始游玩 →</a>
</article>
